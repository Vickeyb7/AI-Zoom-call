rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened reusable primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'vickeyb7@gmail.com'
      );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'lastLoginAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.role is string &&
        data.role.size() <= 20 &&
        data.role in ['member', 'admin'] &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    match /users/{userId} {
      // PII isolation: strictly owner or verified admin
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Create: strict schema, identity match, no self-assigned admin role, server timestamps
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        isOwner(userId) &&
        incoming().email == request.auth.token.email &&
        incoming().createdAt == request.time &&
        incoming().lastLoginAt == request.time &&
        (incoming().role == 'member' || isAdmin());

      // Update: validation helper wraps action-based allowlist
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().lastLoginAt == request.time && (
          // Action: Owner profile & login sync (role and email remain immutable)
          (
            isOwner(userId) &&
            incoming().email == existing().email &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt'])
          ) ||
          // Action: Admin role/profile override
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'role', 'lastLoginAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /admins/{userId} {
      allow get: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list, create, update, delete: if false;
    }
  }
}
