{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile for accessing AI Sales Strategist",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Google account email address"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name from Google profile"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Google profile avatar URL"
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"],
          "maxLength": 20,
          "description": "Platform role (self-registration strictly restricted to member)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of first sign-in"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent sign-in"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "lastLoginAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-managed administrator lookup document for RBAC verification",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated Google user profile documents containing PII"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup table"
    }
  }
}
