# =============================================================================
# AI Provider Configuration (Groq LLM + Local Hugging Face BGE-M3 + Deepgram STT)
# =============================================================================

# 1. LLM Reasoning Provider (Groq ONLY)
LLM_PROVIDER="groq"
# REQUIRED: Groq API key for reasoning via openai/gpt-oss-120b
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
# Optional smaller/faster Groq model for lightweight classification & tagging
GROQ_FAST_MODEL="openai/gpt-oss-20b"

# 2. Local Hugging Face Embeddings (Sentence Transformers / Local ONNX — Embeddings ONLY)
EMBEDDING_PROVIDER="huggingface_local"
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE="64"
EMBEDDING_NORMALIZE="true"
# OPTIONAL: Only needed if downloading gated Hugging Face models locally (not needed for public BAAI/bge-m3)
HF_TOKEN=""

# 3. Speech-to-Text Provider (Deepgram)
# REQUIRED for live speech-to-text audio transcription
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL="nova-3"

# 4. Privacy-First Transcript Retention & Logging
# 0 = ephemeral (raw transcripts stay in memory during active calls only and are NEVER persisted to disk or retained after completion).
# 1..365 = finite auto-purge window in days (never retained indefinitely).
TRANSCRIPT_RETENTION_DAYS="0"
# Allowed values: DEBUG, INFO, WARN, ERROR
LOG_LEVEL="INFO"

# 5. Application & Optional Integrations
APP_URL="MY_APP_URL"
RECALL_API_KEY=""
RECALL_REGION="us-west-2"
ZOOM_WEBHOOK_SECRET=""
