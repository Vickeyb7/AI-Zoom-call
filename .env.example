# GROQ_API_KEY: Required for Groq AI API calls (chat completions & Whisper audio transcription).
# Configure via Settings > Secrets or a local gitignored .env file.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Optional primary Groq chat model (default: openai/gpt-oss-120b).
GROQ_MODEL="openai/gpt-oss-120b"

# GROQ_TRANSCRIBE_MODEL: Optional Groq Whisper audio model (default: whisper-large-v3-turbo).
GROQ_TRANSCRIBE_MODEL="whisper-large-v3-turbo"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RECALL_API_KEY: Optional server-side API key for Recall.ai to dispatch a live Zoom transcription bot.
# Never expose this key to the browser; configure via AI Studio Secrets or .env.
RECALL_API_KEY=""

# RECALL_REGION: Recall.ai regional endpoint (us-west-2, us-east-1, eu-central-1).
RECALL_REGION="us-west-2"

# ZOOM_WEBHOOK_SECRET: Optional HMAC-SHA256 shared secret for verifying incoming Zoom/bot webhooks.
ZOOM_WEBHOOK_SECRET=""
